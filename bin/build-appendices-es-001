#!/usr/bin/env python3
# Regenerates the es-001 appendices 12.2 (metric definitions), 12.6 (references) and 12.7 (index)
# from the es-001 content topics. The home topic is the authority; rerun after any es-001 topic changes.
import os, re, sys
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
rows = [l.rstrip("\n").split("\t") for l in open(f"{root}/spec/topics.tsv")][1:]
VI = f"{root}/locales/es-001/temas"
def nk(n): return [int(x) for x in n.split(".")]
def sec(t, n):
    m = re.search(rf"^## {re.escape(n)}\n(.*?)(?=^## |\Z)", t, re.M | re.S)
    return m.group(1) if m else ""
def table(s):
    out = []
    for l in s.splitlines():
        if l.startswith("|") and not l.startswith("| ---") and not l.startswith("| Métrica |"):
            out.append([x.strip() for x in l.strip().strip("|").split(" | ")])
    return out
def pid(path):
    return open(path).read().strip()
peer = {}
for d in os.listdir(VI):
    p = f"{VI}/{d}/.locale-peer-id"
    if os.path.exists(p): peer[pid(p)] = d
def adir(slug):
    return peer[pid(f"{root}/locales/en-001/topics/{slug}/.locale-peer-id")]
texts, titles, en = {}, {}, {}
PARTS = {}
for part, num, slug, pt in rows:
    if int(part) >= 12: continue
    d = adir(slug)
    texts[num] = open(f"{VI}/{d}/index.md").read()
    titles[num] = texts[num].splitlines()[0][2:]
    en[num] = open(f"{root}/locales/en-001/topics/{slug}/index.md").read()
    if num.endswith(".0"):
        PARTS[part] = re.sub(r"^Introducción a la Parte \d+: ", "", titles[num])

# 12.2 metric definitions
o = []; total = 0; miss = []; cur = None
for part, num, slug, pt in rows:
    if int(part) >= 12 or num.endswith(".0"): continue
    t = texts[num]
    md = table(sec(t, "Definiciones de métricas")); gv = {c[0]: c for c in table(sec(t, "Vectores de manipulación y barreras de protección")) if len(c) == 3}
    if part != cur:
        o.append(f"\n## Parte {part}: {PARTS[part]}\n"); cur = part
    o.append(f"### {num} {titles[num]}\n")
    o.append(f"Tema de origen: (véase el tema {num}, {titles[num]}).\n")
    o.append("| Métrica | Definición | Fórmula | Unidad | Fuente de datos | Práctica de ITIL | Contrapartida ágil | Cadencia | Vector de manipulación | Barrera de protección |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
    for c in md:
        if len(c) != 8: miss.append((num, c[0], len(c))); continue
        g = gv.get(c[0])
        if not g: miss.append((num, c[0], "nogaming")); continue
        o.append("| " + " | ".join(c[:8] + [g[1], g[2]]) + " |"); total += 1
    o.append("")
HEAD = """# Referencia de definiciones y fórmulas de métricas

Este apéndice enumera cada métrica definida en los temas de contenido, agrupada por parte y por tema. Cada entrada lleva la definición, la fórmula, la unidad, la fuente de datos, la práctica de ITIL relacionada, la contrapartida ágil y la cadencia del tema de origen, junto con el vector de manipulación y la barrera de protección correspondientes. Se genera a partir de las dos secciones «Definiciones de métricas» y «Vectores de manipulación y barreras de protección» de cada tema, de modo que el tema de origen es la autoridad. Si una entrada de aquí difiere de su tema, rige el tema y el apéndice se regenera.

## Cómo usar la referencia

- **Consulta antes de adoptar.** Antes de poner una métrica en un panel, lee su entrada, incluidos el vector de manipulación y la barrera de protección, y aplica la barrera de protección junto con ella (véase el tema 1.3, Resultados sobre producción: elegir qué medir).
- **Mide equipos, servicios y sistemas.** Ninguna entrada está pensada para clasificar a individuos (véase el tema 1.2, Ley de Goodhart y psicología de las métricas).
- **Prefiere el tema de origen para los juicios.** Las fórmulas de aquí son breves. Las definiciones de los términos, las notas sobre las muestras y los ejemplos prácticos están en el tema de origen.
- **Registra tus variaciones.** Si tu organización cambia una definición, anota el cambio y el motivo en tu registro de métricas (véase el tema 1.4, Gobernanza y propiedad de las métricas). Una ficha de métrica ayuda (véase el tema 12.4, Plantillas).
- **Las cifras ilustrativas están marcadas.** Este apéndice no contiene valores de referencia. Todas las cifras proceden de tus propias líneas base.
"""
open(f"{VI}/{adir('metric-definitions-and-formulas-reference')}/index.md", "w").write(HEAD + "\n".join(o))
print("12.2 metrics:", total, "missing:", miss, file=sys.stderr)

# 12.6 references (entries are kept verbatim; the cited-in lists use topic numbers)
refs = {}; wiki = {}
for part, num, slug, pt in rows:
    if int(part) >= 12: continue
    m = re.search(r"^## Referencias y lecturas complementarias\n(.*?)\Z", texts[num], re.M | re.S)
    if not m: continue
    for l in m.group(1).splitlines():
        mm = re.match(r"\d+\. (.*)", l)
        if not mm: continue
        r = mm.group(1).strip()
        if r.startswith("Wikipedia, "):
            wm = re.match(r"Wikipedia, \[(.*)\]\((.*)\)\.?$", r)
            wiki.setdefault(wm.group(2), [wm.group(1), []])[1].append(num)
        else:
            refs.setdefault(r, []).append(num)
def key(r): return re.sub(r"[^a-z0-9 ]", "", r.lower())
cite = lambda ns: ", ".join(sorted(set(ns), key=nk))
o = ["# Referencias y lecturas complementarias", "",
     "Este apéndice reúne las fuentes citadas en los temas de contenido, junto con los temas que citan cada una. Las entradas están ordenadas alfabéticamente por autor u organismo y se conservan en su forma original sin cambios. El tema de origen sigue siendo el lugar donde ver cómo se usa una fuente.", "",
     "## Sobre la verificación", "",
     "Los enlaces de Wikipedia de este libro se comprobaron para que se abran. Los libros, los artículos, los estándares y las guías los citaron los autores de memoria y no todos se contrastaron con los originales. Trata los datos bibliográficos (año, edición, título) como pistas que confirmar antes de apoyarte en ellos en un trabajo formal. Reporta las correcciones mediante la skill de mantenimiento.", "",
     "## Libros, artículos, estándares y guías", ""]
for i, r in enumerate(sorted(refs, key=key), 1):
    o.append(f"{i}. {r} (citado en {cite(refs[r])})")
o += ["", "## Artículos de Wikipedia", ""]
for i, (u, (title, ns)) in enumerate(sorted(wiki.items(), key=lambda kv: kv[1][0].lower()), 1):
    o.append(f"{i}. Wikipedia, [{title}]({u}) (citado en {cite(ns)})")
open(f"{VI}/{adir('references-and-further-reading')}/index.md", "w").write("\n".join(o) + "\n")
print("12.6 refs:", len(refs), len(wiki), file=sys.stderr)

# 12.7 index
metrics = {}; wurl = {}
url_title = {u: v[0] for u, v in wiki.items()}
for num, t in texts.items():
    if num.endswith(".0"): continue
    for c in table(sec(t, "Definiciones de métricas")):
        metrics.setdefault(c[0], []).append(num)
    body = t.split("## Referencias y lecturas complementarias")[0]
    for m in re.finditer(r"\]\((https://en\.wikipedia\.org/wiki/[^)\s]+(?:\([^)]*\))?[^)\s]*)\)", body):
        wurl.setdefault(m.group(1), set()).add(num)
FW = ["ITIL 5", "ITIL 4", "ITIL", "DORA", "SPACE", "DevEx", "OKR", "GQM", "Balanced scorecard", "Goal-Question-Metric", "Site reliability", "Lean", "Kanban Guide", "COBIT", "ISO/IEC 20000", "ISO/IEC 27001", "NIST", "Cynefin", "Value stream mapping", "HEART", "Four Keys", "Westrum", "CMMI", "FinOps", "COPC", "Team Topologies", "Theory of constraints"]
fw = {}
for f in FW:
    ns = [n for n, t in en.items() if re.search(rf"\b{re.escape(f)}\b", t.split("## References and further reading")[0])]
    if ns: fw[f] = ns
def fmt(ns): return ", ".join(sorted(set(ns), key=nk))
o = ["# Índice", "",
     "Conceptos, marcos y métricas, cada uno con remisiones a los temas en que aparecen. Los números son números de tema. Los títulos están en el índice de contenidos del README y en la [estructura](../../../../spec/structure.md). Para definiciones breves con sus temas de origen, véase el tema 12.1, Glosario.", "",
     "## Marcos y modelos", ""]
for f in sorted(fw, key=str.lower):
    o.append(f"- **{f}**: {fmt(fw[f]) if len(fw[f]) <= 12 else fmt(sorted(fw[f], key=nk)[:12]) + ' y otros temas'}")
o += ["", "## Métricas", "", "Los nombres de las métricas tal como aparecen en la tabla de definiciones de cada tema. Las entradas completas están en el apéndice 12.2 (véase el tema 12.2, Referencia de definiciones y fórmulas de métricas).", ""]
for k in sorted(metrics): o.append(f"- **{k}**: {fmt(metrics[k])}")
o += ["", "## Conceptos", "", "Los conceptos proceden de los términos para los que cada tema enlaza con Wikipedia como contexto (los títulos de los artículos siguen en inglés). El primer número suele ser el tema que explica el concepto de forma más completa.", ""]
for u in sorted(wurl, key=lambda u: url_title.get(u, u).lower()):
    o.append(f"- **{url_title.get(u, u.rsplit('/', 1)[-1].replace('_', ' '))}**: {fmt(wurl[u])}")
open(f"{VI}/{adir('index')}/index.md", "w").write("\n".join(o) + "\n")
print("12.7:", len(fw), len(metrics), len(wurl), file=sys.stderr)
