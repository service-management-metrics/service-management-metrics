#!/usr/bin/env python3
# Regenerates the bn-001 appendices 12.2 (metric definitions), 12.6 (references) and 12.7 (index)
# from the bn-001 content topics. The home topic is the authority; rerun after any bn-001 topic changes.
import os, re, sys
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
rows = [l.rstrip("\n").split("\t") for l in open(f"{root}/spec/topics.tsv")][1:]
HI = f"{root}/locales/bn-001/বিষয়"
def nk(n): return [int(x) for x in n.split(".")]
def sec(t, n):
    m = re.search(rf"^## {re.escape(n)}\n(.*?)(?=^## |\Z)", t, re.M | re.S)
    return m.group(1) if m else ""
def table(s):
    out = []
    for l in s.splitlines():
        if l.startswith("|") and not l.startswith("| ---") and not l.startswith("| মেট্রিক |"):
            out.append([x.strip() for x in l.strip().strip("|").split(" | ")])
    return out
# map slug -> bn-001 directory through the shared locale peer id
def pid(path):
    return open(path).read().strip()
peer = {}
for d in os.listdir(HI):
    p = f"{HI}/{d}/.locale-peer-id"
    if os.path.exists(p): peer[pid(p)] = d
def adir(slug):
    return peer[pid(f"{root}/locales/en-001/topics/{slug}/.locale-peer-id")]
texts, titles, en = {}, {}, {}
PARTS = {}
for part, num, slug, pt in rows:
    if int(part) >= 12: continue
    d = adir(slug)
    texts[num] = open(f"{HI}/{d}/index.md").read()
    titles[num] = texts[num].splitlines()[0][2:]
    en[num] = open(f"{root}/locales/en-001/topics/{slug}/index.md").read()
    if num.endswith(".0"): PARTS[part] = titles[num].split(": ", 1)[-1]

# 12.2 metric definitions
o = []; total = 0; miss = []; cur = None
for part, num, slug, pt in rows:
    if int(part) >= 12 or num.endswith(".0"): continue
    t = texts[num]
    md = table(sec(t, "মেট্রিকের সংজ্ঞা")); gv = {c[0]: c for c in table(sec(t, "কারসাজির উপায় ও রক্ষাবেষ্টনী")) if len(c) == 3}
    if part != cur:
        o.append(f"\n## অংশ {part}: {PARTS[part]}\n"); cur = part
    o.append(f"### {num} {titles[num]}\n")
    o.append(f"মূল বিষয়: (বিষয় {num}, {titles[num]} দেখুন)।\n")
    o.append("| মেট্রিক | সংজ্ঞা | সূত্র | একক | তথ্যের উৎস | ITIL চর্চা | এজাইল সমতুল্য | পর্যায়কাল | কারসাজির উপায় | রক্ষাবেষ্টনী |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
    for c in md:
        if len(c) != 8: miss.append((num, c[0], len(c))); continue
        g = gv.get(c[0])
        if not g: miss.append((num, c[0], "nogaming")); continue
        o.append("| " + " | ".join(c[:8] + [g[1], g[2]]) + " |"); total += 1
    o.append("")
HEAD = """# মেট্রিকের সংজ্ঞা ও সূত্রের নির্দেশিকা

এই পরিশিষ্ট বিষয়বস্তুর বিষয়গুলোতে সংজ্ঞায়িত প্রতিটি মেট্রিক অংশ ও বিষয় অনুযায়ী সাজিয়ে তালিকাভুক্ত করে। প্রতিটি প্রবেশে মূল বিষয় থেকে সংজ্ঞা, সূত্র, একক, তথ্যের উৎস, সম্পর্কিত ITIL চর্চা, এজাইল সমতুল্য ও পর্যায়কাল আছে, সঙ্গে কারসাজির উপায় ও জোড়া রক্ষাবেষ্টনী। এটি প্রতিটি বিষয়ের "মেট্রিকের সংজ্ঞা" এবং "কারসাজির উপায় ও রক্ষাবেষ্টনী" অংশ থেকে তৈরি, তাই মূল বিষয়ই প্রামাণিক: এখানকার কোনো প্রবেশ তার বিষয় থেকে আলাদা হলে বিষয়ই প্রযোজ্য এবং এই পরিশিষ্ট নতুন করে তৈরি হয়।

## এই নির্দেশিকা কীভাবে ব্যবহার করবেন

- **গ্রহণের আগে দেখুন।** ড্যাশবোর্ডে কোনো মেট্রিক যোগ করার আগে তার প্রবেশ পড়ুন, কারসাজির উপায় ও রক্ষাবেষ্টনী সহ, এবং রক্ষাবেষ্টনীটি তার সঙ্গে গ্রহণ করুন (বিষয় 1.3, আউটপুটের চেয়ে ফলাফল: কী পরিমাপ করব তা বাছাই দেখুন)।
- **দল, সেবা ও ব্যবস্থা পরিমাপ করুন।** কোনো প্রবেশ ব্যক্তিকে ক্রম দেওয়ার জন্য নয় (বিষয় 1.2, গুডহার্টের সূত্র ও মেট্রিকের মনস্তত্ত্ব দেখুন)।
- **বিচারের জন্য মূল বিষয় দেখুন।** এখানকার সূত্র সংক্ষিপ্ত। পদের সংজ্ঞা, নমুনার সতর্কতা এবং কাজের উদাহরণ মূল বিষয়ে আছে।
- **নিজের রূপান্তর লিপিবদ্ধ করুন।** আপনার প্রতিষ্ঠান কোনো সংজ্ঞা বদলালে পরিবর্তন ও তার কারণ আপনার মেট্রিক ক্যাটালগে লিপিবদ্ধ করুন (বিষয় 1.4, মেট্রিকের গভর্ন্যান্স ও মালিকানা দেখুন)। মেট্রিক কার্ড সাহায্য করে (বিষয় 12.4, টেমপ্লেট দেখুন)।
- **দৃষ্টান্তমূলক সংখ্যা চিহ্নিত।** এই পরিশিষ্টে কোনো বেঞ্চমার্ক মান নেই। যেকোনো সংখ্যা আসা উচিত আপনার নিজের ভিত্তিরেখা থেকে।
"""
open(f"{HI}/{adir('metric-definitions-and-formulas-reference')}/index.md", "w").write(HEAD + "\n".join(o))
print("12.2 metrics:", total, "missing:", miss, file=sys.stderr)

# 12.6 references (entries are kept verbatim; the cited-in lists use topic numbers)
refs = {}; wiki = {}
for part, num, slug, pt in rows:
    if int(part) >= 12: continue
    m = re.search(r"^## তথ্যসূত্র ও আরও পড়ার জন্য\n(.*?)\Z", texts[num], re.M | re.S)
    if not m: continue
    for l in m.group(1).splitlines():
        mm = re.match(r"\d+\. (.*)", l)
        if not mm: continue
        r = mm.group(1).strip()
        if r.startswith("Wikipedia, "):
            wm = re.match(r"Wikipedia, \[(.*)\]\((.*)\)\.?$", r)
            wiki.setdefault(wm.group(2), [wm.group(1), []])[1].append(num)
        else:
            refs.setdefault(r, []).append(num)
def key(r): return re.sub(r"[^a-z0-9 ]", "", r.lower())
cite = lambda ns: ", ".join(sorted(set(ns), key=nk))
o = ["# তথ্যসূত্র ও আরও পড়ার জন্য", "",
     "এই পরিশিষ্ট বিষয়বস্তুর বিষয়গুলোতে উদ্ধৃত তথ্যসূত্র এক জায়গায় সংগ্রহ করে এবং বলে কোন বিষয়গুলো প্রতিটি উদ্ধৃত করে। প্রবেশগুলো লেখক বা প্রতিষ্ঠানের নামের বর্ণানুক্রমে এবং মূল রূপে রাখা হয়েছে। কোনো উৎস কীভাবে ব্যবহৃত হয়েছে দেখতে মূল বিষয় দেখুন।", "",
     "## যাচাই সম্পর্কে", "",
     "এই বইয়ের উইকিপিডিয়া লিংক খোলে কি না তা যাচাই করা হয়েছে। বই, গবেষণাপত্র, মান ও নির্দেশিকা দলিল লেখকরা স্মৃতি থেকে উদ্ধৃত করেছেন এবং সবগুলোর মূল কপির সঙ্গে মিলিয়ে দেখা হয়নি। গ্রন্থপঞ্জির বিবরণ (বছর, সংস্করণ, শিরোনাম) ইঙ্গিত হিসেবে নিন এবং আনুষ্ঠানিক কাজে নির্ভর করার আগে নিশ্চিত করুন। সংশোধন maintainer skill-এর মাধ্যমে জানান।", "",
     "## বই, গবেষণাপত্র, মান ও নির্দেশিকা দলিল", ""]
for i, r in enumerate(sorted(refs, key=key), 1):
    o.append(f"{i}. {r} (উদ্ধৃত: {cite(refs[r])})")
o += ["", "## উইকিপিডিয়ার নিবন্ধ", ""]
for i, (u, (title, ns)) in enumerate(sorted(wiki.items(), key=lambda kv: kv[1][0].lower()), 1):
    o.append(f"{i}. Wikipedia, [{title}]({u}) (উদ্ধৃত: {cite(ns)})")
open(f"{HI}/{adir('references-and-further-reading')}/index.md", "w").write("\n".join(o) + "\n")
print("12.6 refs:", len(refs), len(wiki), file=sys.stderr)

# 12.7 index
metrics = {}; wurl = {}
url_title = {u: v[0] for u, v in wiki.items()}
for num, t in texts.items():
    if num.endswith(".0"): continue
    for c in table(sec(t, "মেট্রিকের সংজ্ঞা")):
        metrics.setdefault(c[0], []).append(num)
    body = t.split("## তথ্যসূত্র ও আরও পড়ার জন্য")[0]
    for m in re.finditer(r"\]\((https://en\.wikipedia\.org/wiki/[^)\s]+(?:\([^)]*\))?[^)\s]*)\)", body):
        wurl.setdefault(m.group(1), set()).add(num)
FW = ["ITIL 5", "ITIL 4", "ITIL", "DORA", "SPACE", "DevEx", "OKR", "GQM", "Balanced scorecard", "Goal-Question-Metric", "Site reliability", "Lean", "Kanban Guide", "COBIT", "ISO/IEC 20000", "ISO/IEC 27001", "NIST", "Cynefin", "Value stream mapping", "HEART", "Four Keys", "Westrum", "CMMI", "FinOps", "COPC", "Team Topologies", "Theory of constraints"]
fw = {}
for f in FW:
    ns = [n for n, t in en.items() if re.search(rf"\b{re.escape(f)}\b", t.split("## References and further reading")[0])]
    if ns: fw[f] = ns
def fmt(ns): return ", ".join(sorted(set(ns), key=nk))
o = ["# বর্ণানুক্রমিক সূচি", "",
     "ধারণা, কাঠামো ও মেট্রিক, প্রতিটি সেই বিষয়গুলোর দিকে নির্দেশ করে যেখানে তা আসে। সংখ্যাগুলো বিষয়ের সংখ্যা; শিরোনাম README-এর সূচিপত্রে এবং [কাঠামো](../../../../spec/structure.md)-তে আছে। মূল বিষয়ের সংক্ষিপ্ত সংজ্ঞার জন্য বিষয় 12.1, শব্দকোষ দেখুন।", "",
     "## কাঠামো ও মডেল", ""]
for f in sorted(fw, key=str.lower):
    o.append(f"- **{f}**: {fmt(fw[f]) if len(fw[f]) <= 12 else fmt(sorted(fw[f], key=nk)[:12]) + ' ইত্যাদি'}")
o += ["", "## মেট্রিক", "", "মেট্রিকের নাম তা-ই যা বিষয়গুলোর সংজ্ঞার সারণিতে আসে। পূর্ণ প্রবেশ পরিশিষ্ট 12.2-এ আছে (বিষয় 12.2, মেট্রিকের সংজ্ঞা ও সূত্রের নির্দেশিকা দেখুন)।", ""]
for k in sorted(metrics): o.append(f"- **{k}**: {fmt(metrics[k])}")
o += ["", "## ধারণা", "", "ধারণাগুলো সেই পদ থেকে নেওয়া যা বিষয়গুলো পটভূমির জন্য উইকিপিডিয়ার সঙ্গে যুক্ত করে (প্রবেশের শিরোনাম ইংরেজিতে রাখা হয়েছে)। প্রথম সংখ্যাটি সাধারণত সেই বিষয় যা ধারণাটি সবচেয়ে বিস্তারিত ব্যাখ্যা করে।", ""]
for u in sorted(wurl, key=lambda u: url_title.get(u, u).lower()):
    o.append(f"- **{url_title.get(u, u.rsplit('/', 1)[-1].replace('_', ' '))}**: {fmt(wurl[u])}")
open(f"{HI}/{adir('index')}/index.md", "w").write("\n".join(o) + "\n")
print("12.7:", len(fw), len(metrics), len(wurl), file=sys.stderr)
