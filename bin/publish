#!/bin/sh
set -euf

## Publish the website: push service-management-metrics.github.io/ (this repo's
## site folder) to the site's own repository as a subtree split. The split is
## deterministic; when the remote has diverged, its tip is merged in first.
## and the push is always a fast-forward of the site repo's main branch.
##
## Usage: bin/publish [--dry-run]
## Env:   SITE_REMOTE  push URL (default: the site repo over SSH, for deploy keys)

remote="${SITE_REMOTE:-git@github.com:service-management-metrics/service-management-metrics.github.io.git}"
prefix="service-management-metrics.github.io"
dry=""
test "${1:-}" = "--dry-run" && dry="--dry-run"

top="$(git rev-parse --show-toplevel)"
cd "$top"

test -z "$(git status --porcelain -- "$prefix")" \
    || { >&2 echo "Error: uncommitted changes under $prefix/; commit them first."; exit 1; }

## git subtree split prints progress with carriage returns; the hash is last.
sha="$(git subtree split --prefix="$prefix" HEAD 2>/dev/null | tr '\r' '\n' | tail -n 1 | tr -d '[:space:]')"
test -n "$sha" && git cat-file -e "${sha}^{commit}" \
    || { >&2 echo "Error: subtree split did not produce a commit."; exit 1; }

## The site repo's history holds merge commits from earlier deploys, so the
## split alone is not a fast-forward. Merge the remote tip in, keeping the
## split's tree, so the push is always a fast-forward.
if git fetch -q "$remote" main 2>/dev/null; then
    tip="$(git rev-parse FETCH_HEAD)"
    if ! git merge-base --is-ancestor "$tip" "$sha"; then
        sha="$(git commit-tree "${sha}^{tree}" -p "$tip" -p "$sha" -m "Merge remote site main; deploy")"
    fi
fi

echo "Publishing $sha to $remote (main)"
## shellcheck disable=SC2086
git push $dry "$remote" "${sha}:refs/heads/main"
