#!/usr/bin/env python3
"""Regenerate the README table of contents between toc markers from spec/topics.tsv and topic headlines."""
import os, re
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
rows = [l.rstrip("\n").split("\t") for l in open(f"{root}/spec/topics.tsv")][1:]
out, cur = [], None
for part, num, slug, ptitle in rows:
    if part != cur:
        cur = part; out += ["", f"**Part {part}: {ptitle}**", ""]
    title = open(f"{root}/locales/en-001/topics/{slug}/index.md").readline().lstrip("# ").strip()
    out.append(f"- Topic {num}: [{title}](locales/en-001/topics/{slug}/)")
toc = "<!-- toc:start -->" + "\n".join(out) + "\n<!-- toc:end -->"
p = f"{root}/README.md"
s = open(p).read()
s = re.sub(r"<!-- toc:start -->.*<!-- toc:end -->", lambda m: toc, s, flags=re.S)
open(p, "w").write(s)
