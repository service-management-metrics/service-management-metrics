#!/usr/bin/env python3
# Regenerates the zh-cn appendices 12.2 (metric definitions), 12.6 (references) and 12.7 (index)
# from the zh-cn content topics. The home topic is the authority; rerun after any zh-cn topic changes.
import os, re, sys
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
rows = [l.rstrip("\n").split("\t") for l in open(f"{root}/spec/topics.tsv")][1:]
ZH = f"{root}/locales/zh-cn/主题"
PARTS = {"1": "度量基础", "2": "流动与持续交付度量", "3": "服务台、事件与请求度量", "4": "问题、变更与发布度量",
         "5": "服务级别、可用性与可靠性度量", "6": "客户与体验度量", "7": "资产、配置与财务度量",
         "8": "安全、风险、合规与供应商度量", "9": "人员、团队与改进度量", "10": "AI、自动化与分析度量", "11": "构建度量计划"}
def nk(n): return [int(x) for x in n.split(".")]
def sec(t, n):
    m = re.search(rf"^## {re.escape(n)}\n(.*?)(?=^## |\Z)", t, re.M | re.S)
    return m.group(1) if m else ""
def table(s):
    out = []
    for l in s.splitlines():
        if l.startswith("|") and not l.startswith("| ---") and not l.startswith("| 度量 |"):
            out.append([x.strip() for x in l.strip().strip("|").split(" | ")])
    return out
# map slug -> zh-cn directory through the shared locale peer id
def pid(path):
    return open(path).read().strip()
peer = {}
for d in os.listdir(ZH):
    p = f"{ZH}/{d}/.locale-peer-id"
    if os.path.exists(p): peer[pid(p)] = d
def adir(slug):
    return peer[pid(f"{root}/locales/en-001/topics/{slug}/.locale-peer-id")]
zhdirs = {}
texts, titles, en = {}, {}, {}
for part, num, slug, pt in rows:
    if int(part) >= 12: continue
    d = adir(slug)
    zhdirs[num] = d
    texts[num] = open(f"{ZH}/{d}/index.md").read()
    titles[num] = texts[num].splitlines()[0][2:]
    en[num] = open(f"{root}/locales/en-001/topics/{slug}/index.md").read()

# 12.2 metric definitions
o = []; total = 0; miss = []; cur = None
for part, num, slug, pt in rows:
    if int(part) >= 12 or num.endswith(".0"): continue
    t = texts[num]
    md = table(sec(t, "度量定义")); gv = {c[0]: c for c in table(sec(t, "钻空子途径与护栏")) if len(c) == 3}
    if part != cur:
        o.append(f"\n## 第 {part} 部分：{PARTS[part]}\n"); cur = part
    o.append(f"### {num} {titles[num]}\n")
    o.append(f"所在主题：（见主题 {num}，{titles[num]}）。\n")
    o.append("| 度量 | 定义 | 公式 | 单位 | 数据来源 | ITIL 实践 | 敏捷对应物 | 节奏 | 钻空子途径 | 护栏 |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
    for c in md:
        if len(c) != 8: miss.append((num, c[0], len(c))); continue
        g = gv.get(c[0])
        if not g: miss.append((num, c[0], "nogaming")); continue
        o.append("| " + " | ".join(c[:8] + [g[1], g[2]]) + " |"); total += 1
    o.append("")
HEAD = """# 度量定义与公式参考

本附录列出内容主题中定义的每一项测量值，按部分和主题分组。每个条目都带有来自所在主题的定义、公式、单位、数据来源、相关的 ITIL 实践、敏捷对应物和节奏，以及钻空子途径和配对的护栏。它由各主题的“度量定义”和“钻空子途径与护栏”两节生成，所以所在主题是权威：当此处的条目与其主题不同时，以主题为准，并且本附录会被重新生成。

## 如何使用本参考

- **采用之前先查阅。** 在把某项测量值加入仪表盘之前，阅读它的条目，包括钻空子途径和护栏，并连同它一起采用护栏（见主题 1.3，结果重于产出：选择度量什么）。
- **度量团队、服务和系统。** 没有哪个条目是为给个人排名而设的（见主题 1.2，古德哈特定律与度量的心理学）。
- **判断请以所在主题为准。** 这里的公式很简短。术语的定义、抽样的注意事项和实践示例都在所在主题中。
- **记录你自己的变体。** 如果你的组织更改了某项定义，请在你的度量目录中记录变更及其理由（见主题 1.4，度量治理与归属）。度量卡会有帮助（见主题 12.4，模板）。
- **示意性的数字有标注。** 本附录不含基准值。任何数字都来自你自己的基线。
"""
open(f"{ZH}/{adir('metric-definitions-and-formulas-reference')}/index.md", "w").write(HEAD + "\n".join(o))
print("12.2 metrics:", total, "missing:", miss, file=sys.stderr)

# 12.6 references (entries are kept verbatim; the cited-in lists use topic numbers)
refs = {}; wiki = {}
for part, num, slug, pt in rows:
    if int(part) >= 12: continue
    m = re.search(r"^## 参考文献与延伸阅读\n(.*?)\Z", texts[num], re.M | re.S)
    if not m: continue
    for l in m.group(1).splitlines():
        mm = re.match(r"\d+\. (.*)", l)
        if not mm: continue
        r = mm.group(1).strip()
        if r.startswith("Wikipedia, "):
            wm = re.match(r"Wikipedia, \[(.*)\]\((.*)\)\.?$", r)
            wiki.setdefault(wm.group(2), [wm.group(1), []])[1].append(num)
        else:
            refs.setdefault(r, []).append(num)
def key(r): return re.sub(r"[^a-z0-9 ]", "", r.lower())
cite = lambda ns: "、".join(sorted(set(ns), key=nk))
o = ["# 参考文献与延伸阅读", "",
     "本附录汇总内容主题中引用的参考文献，并列出引用每一条的主题。条目按作者或机构的字母顺序排列，保留原文。要查看某个来源如何被使用，请以所在主题为准。", "",
     "## 关于核实", "",
     "本书中的维基百科链接已检查可以打开。书籍、论文、标准和指导文件是由作者凭记忆引用的，尚未全部对照原件核对。请把书目细节（年份、版本、标题）视为线索，在正式工作中依赖它们之前加以确认。请通过维护者技能报告更正。", "",
     "## 书籍、论文、标准和指导文件", ""]
for i, r in enumerate(sorted(refs, key=key), 1):
    o.append(f"{i}. {r}（引用于 {cite(refs[r])}）")
o += ["", "## 维基百科文章", ""]
for i, (u, (title, ns)) in enumerate(sorted(wiki.items(), key=lambda kv: kv[1][0].lower()), 1):
    o.append(f"{i}. Wikipedia, [{title}]({u})（引用于 {cite(ns)}）")
open(f"{ZH}/{adir('references-and-further-reading')}/index.md", "w").write("\n".join(o) + "\n")
print("12.6 refs:", len(refs), len(wiki), file=sys.stderr)

# 12.7 index
metrics = {}; wurl = {}
url_title = {u: v[0] for u, v in wiki.items()}
for num, t in texts.items():
    if num.endswith(".0"): continue
    for c in table(sec(t, "度量定义")):
        metrics.setdefault(c[0], []).append(num)
    body = t.split("## 参考文献与延伸阅读")[0]
    for m in re.finditer(r"\]\((https://en\.wikipedia\.org/wiki/[^)\s]+(?:\([^)]*\))?[^)\s]*)\)", body):
        wurl.setdefault(m.group(1), set()).add(num)
FW = ["ITIL 5", "ITIL 4", "ITIL", "DORA", "SPACE", "DevEx", "OKR", "GQM", "Balanced scorecard", "Goal-Question-Metric", "Site reliability", "Lean", "Kanban Guide", "COBIT", "ISO/IEC 20000", "ISO/IEC 27001", "NIST", "Cynefin", "Value stream mapping", "HEART", "Four Keys", "Westrum", "CMMI", "FinOps", "COPC", "Team Topologies", "Theory of constraints"]
fw = {}
for f in FW:
    ns = [n for n, t in en.items() if re.search(rf"\b{re.escape(f)}\b", t.split("## References and further reading")[0])]
    if ns: fw[f] = ns
def fmt(ns): return "、".join(sorted(set(ns), key=nk))
o = ["# 索引", "",
     "概念、框架和测量值，每一项都指向它们出现的主题。数字是主题编号；标题见 README 的目录以及[结构](../../../../spec/structure.md)。关于带有所在主题的简短定义，见主题 12.1，术语表。", "",
     "## 框架与模型", ""]
for f in sorted(fw, key=str.lower):
    o.append(f"- **{f}**：{fmt(fw[f]) if len(fw[f]) <= 12 else fmt(sorted(fw[f], key=nk)[:12]) + ' 等'}")
o += ["", "## 测量值", "", "测量值名称与它们在各主题的定义表中出现的一致。完整的条目见附录 12.2（见主题 12.2，度量定义与公式参考）。", ""]
for k in sorted(metrics): o.append(f"- **{k}**：{fmt(metrics[k])}")
o += ["", "## 概念", "", "概念取自各主题为背景知识而链接到维基百科的术语（条目标题保留英文）。第一个数字通常是对该概念解释得最详细的主题。", ""]
for u in sorted(wurl, key=lambda u: url_title.get(u, u).lower()):
    o.append(f"- **{url_title.get(u, u.rsplit('/', 1)[-1].replace('_', ' '))}**：{fmt(wurl[u])}")
open(f"{ZH}/{adir('index')}/index.md", "w").write("\n".join(o) + "\n")
print("12.7:", len(fw), len(metrics), len(wurl), file=sys.stderr)
