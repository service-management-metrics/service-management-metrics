#!/usr/bin/env python3
# Regenerates an appendix from the topics.
import re,sys
import os
root=os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
rows=[l.rstrip("\n").split("\t") for l in open(f"{root}/spec/topics.tsv")][1:]
def nk(n): return [int(x) for x in n.split(".")]
texts={}; titles={}
for part,num,slug,pt in rows:
    if int(part)>=12: continue
    t=open(f"{root}/locales/en-001/topics/{slug}/index.md").read()
    texts[num]=t; titles[num]=t.splitlines()[0][2:]
def sec(t,n):
    m=re.search(rf"^## {re.escape(n)}\n(.*?)(?=^## |\Z)",t,re.M|re.S); return m.group(1) if m else ""
metrics={}; wiki={}
for num,t in texts.items():
    if num.endswith(".0"): continue
    for l in sec(t,"Metric definitions").splitlines():
        if l.startswith("| ") and not l.startswith("| Metric |") and not l.startswith("| ---"):
            metrics.setdefault(l.split(" | ")[0].strip("| ").strip(),[]).append(num)
    for m in re.finditer(r"\[([^\]]+)\]\(https://en\.wikipedia\.org/wiki/[^)]+(?:\([^)]*\))?[^)]*\)", t.split("## References and further reading")[0]):
        wiki.setdefault(m.group(1).lower(),[m.group(1),set()])[1].add(num)
FW=["ITIL 5","ITIL 4","ITIL","DORA","SPACE","DevEx","OKR","GQM","Balanced scorecard","Goal-Question-Metric","Site reliability","Lean","Kanban Guide","COBIT","ISO/IEC 20000","ISO/IEC 27001","NIST","Cynefin","Value stream mapping","HEART","Four Keys","Westrum","CMMI","FinOps","COPC","Team Topologies","Theory of constraints"]
fw={}
for f in FW:
    ns=[n for n,t in texts.items() if re.search(rf"\b{re.escape(f)}\b",t.split("## References and further reading")[0])]
    if ns: fw[f]=ns
def fmt(ns): return ", ".join(sorted(set(ns),key=nk))
o=["# Index","","Concepts, frameworks, and metrics, each pointing to the topics where they appear. Numbers are topic numbers; titles are in the table of contents of the README and in [structure](../../../../spec/structure.md). For short definitions with a home topic, see topic 12.1, Glossary.","",
"## Frameworks and models","",]
for f in sorted(fw,key=str.lower): o.append(f"- **{f}**: {fmt(fw[f]) if len(fw[f])<=12 else fmt(fw[f][:12])+', and others'}")
o+=["","## Metrics","","Metric names as they appear in each topic's definitions table. The full entries are in appendix 12.2 (see topic 12.2, Metric definitions and formulas reference).",""]
for k in sorted(metrics,key=str.lower): o.append(f"- **{k}**: {fmt(metrics[k])}")
o+=["","## Concepts","","Concepts are drawn from the terms that topics link to Wikipedia for background. The first number is usually the topic that explains the concept in the most detail.",""]
for k,(title,ns) in sorted(wiki.items()): o.append(f"- **{title}**: {fmt(ns)}")
open(f"{root}/locales/en-001/topics/index/index.md","w").write("\n".join(o)+"\n")
print(len(fw),len(metrics),len(wiki))
