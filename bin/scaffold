#!/usr/bin/env python3
"""Create missing topic stubs from spec/topics.tsv and spec/structure.md. Never overwrites."""
import os, re, secrets, sys
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
rows = [l.rstrip("\n").split("\t") for l in open(f"{root}/spec/topics.tsv")][1:]
titles = {}
for line in open(f"{root}/spec/structure.md"):
    m = re.match(r"\| (\d+\.\d+) \| `([^`]+)` \| (.+?) \| (.*) \|$", line)
    if m: titles[m.group(1)] = (m.group(3), m.group(4))
for part, num, slug, ptitle in rows:
    d = f"{root}/locales/en-001/topics/{slug}"
    os.makedirs(d, exist_ok=True)
    idx = f"{d}/index.md"
    if not os.path.exists(idx):
        t, scope = titles[num]
        open(idx, "w").write(f"# {t}\n\n<!-- stub -->\n\n> Not yet written. Scope: {scope}\n")
    rd = f"{d}/README.md"
    if not os.path.lexists(rd): os.symlink("index.md", rd)
    pid = f"{d}/.locale-peer-id"
    if not os.path.exists(pid): open(pid, "w").write(secrets.token_hex(16) + "\n")
