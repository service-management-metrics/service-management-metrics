#!/usr/bin/env python3
# Regenerates the pt-001 appendices 12.2 (metric definitions), 12.6 (references) and 12.7 (index)
# from the pt-001 content topics. The home topic is the authority; rerun after any pt-001 topic changes.
import os, re, sys
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
rows = [l.rstrip("\n").split("\t") for l in open(f"{root}/spec/topics.tsv")][1:]
VI = f"{root}/locales/pt-001/tópicos"
def nk(n): return [int(x) for x in n.split(".")]
def sec(t, n):
    m = re.search(rf"^## {re.escape(n)}\n(.*?)(?=^## |\Z)", t, re.M | re.S)
    return m.group(1) if m else ""
def table(s):
    out = []
    for l in s.splitlines():
        if l.startswith("|") and not l.startswith("| ---") and not l.startswith("| Métrica |"):
            out.append([x.strip() for x in l.strip().strip("|").split(" | ")])
    return out
def pid(path):
    return open(path).read().strip()
peer = {}
for d in os.listdir(VI):
    p = f"{VI}/{d}/.locale-peer-id"
    if os.path.exists(p): peer[pid(p)] = d
def adir(slug):
    return peer[pid(f"{root}/locales/en-001/topics/{slug}/.locale-peer-id")]
texts, titles, en = {}, {}, {}
PARTS = {}
for part, num, slug, pt in rows:
    if int(part) >= 12: continue
    d = adir(slug)
    texts[num] = open(f"{VI}/{d}/index.md").read()
    titles[num] = texts[num].splitlines()[0][2:]
    en[num] = open(f"{root}/locales/en-001/topics/{slug}/index.md").read()
    if num.endswith(".0"):
        PARTS[part] = re.sub(r"^Introdução à Parte \d+: ", "", titles[num])

# 12.2 metric definitions
o = []; total = 0; miss = []; cur = None
for part, num, slug, pt in rows:
    if int(part) >= 12 or num.endswith(".0"): continue
    t = texts[num]
    md = table(sec(t, "Definições de métricas")); gv = {c[0]: c for c in table(sec(t, "Vetores de manipulação e barreiras de proteção")) if len(c) == 3}
    if part != cur:
        o.append(f"\n## Parte {part}: {PARTS[part]}\n"); cur = part
    o.append(f"### {num} {titles[num]}\n")
    o.append(f"Tópico de origem: (veja o tópico {num}, {titles[num]}).\n")
    o.append("| Métrica | Definição | Fórmula | Unidade | Fonte de dados | Prática ITIL | Equivalente ágil | Cadência | Vetor de manipulação | Barreira de proteção |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
    for c in md:
        if len(c) != 8: miss.append((num, c[0], len(c))); continue
        g = gv.get(c[0])
        if not g: miss.append((num, c[0], "nogaming")); continue
        o.append("| " + " | ".join(c[:8] + [g[1], g[2]]) + " |"); total += 1
    o.append("")
HEAD = """# Referência de definições e fórmulas de métricas

Este apêndice lista cada métrica definida nos tópicos de conteúdo, agrupada por parte e por tópico. Cada entrada traz a definição, a fórmula, a unidade, a fonte de dados, a prática ITIL relacionada, o equivalente ágil e a cadência do tópico de origem, junto com o vetor de manipulação e a barreira de proteção correspondentes. É gerado a partir das duas seções "Definições de métricas" e "Vetores de manipulação e barreiras de proteção" de cada tópico, de modo que o tópico de origem é a autoridade. Se uma entrada daqui diferir do seu tópico, vale o tópico, e o apêndice é regerado.

## Como usar a referência

- **Consulte antes de adotar.** Antes de pôr uma métrica em um painel, leia a entrada dela, incluindo o vetor de manipulação e a barreira de proteção, e aplique a barreira de proteção junto com ela (veja o tópico 1.3, Resultados acima da produção: escolher o que medir).
- **Meça equipes, serviços e sistemas.** Nenhuma entrada se destina a classificar indivíduos (veja o tópico 1.2, A lei de Goodhart e a psicologia das métricas).
- **Prefira o tópico de origem para os julgamentos.** As fórmulas aqui são breves. As definições dos termos, as notas sobre as amostras e os exemplos práticos estão no tópico de origem.
- **Registre suas variações.** Se sua organização muda uma definição, anote a mudança e o motivo no seu registro de métricas (veja o tópico 1.4, Governança e responsabilidade das métricas). Um cartão de métrica ajuda (veja o tópico 12.4, Modelos).
- **As cifras ilustrativas estão marcadas.** Este apêndice não contém valores de referência. Todas as cifras vêm das suas próprias linhas de base.
"""
open(f"{VI}/{adir('metric-definitions-and-formulas-reference')}/index.md", "w").write(HEAD + "\n".join(o))
print("12.2 metrics:", total, "missing:", miss, file=sys.stderr)

# 12.6 references (entries are kept verbatim; the cited-in lists use topic numbers)
refs = {}; wiki = {}
for part, num, slug, pt in rows:
    if int(part) >= 12: continue
    m = re.search(r"^## Referências e leituras complementares\n(.*?)\Z", texts[num], re.M | re.S)
    if not m: continue
    for l in m.group(1).splitlines():
        mm = re.match(r"\d+\. (.*)", l)
        if not mm: continue
        r = mm.group(1).strip()
        if r.startswith("Wikipedia, "):
            wm = re.match(r"Wikipedia, \[(.*)\]\((.*)\)\.?$", r)
            wiki.setdefault(wm.group(2), [wm.group(1), []])[1].append(num)
        else:
            refs.setdefault(r, []).append(num)
def key(r): return re.sub(r"[^a-z0-9 ]", "", r.lower())
cite = lambda ns: ", ".join(sorted(set(ns), key=nk))
o = ["# Referências e leituras complementares", "",
     "Este apêndice reúne as fontes citadas nos tópicos de conteúdo, junto com os tópicos que citam cada uma. As entradas estão em ordem alfabética por autor ou organismo e são mantidas em sua forma original, sem alterações. O tópico de origem continua sendo o lugar para ver como uma fonte é usada.", "",
     "## Sobre a verificação", "",
     "Os links da Wikipedia deste livro foram conferidos para abrir. Os livros, artigos, normas e guias foram citados de memória pelos autores, e nem todos foram cotejados com os originais. Trate os dados bibliográficos (ano, edição, título) como pistas a confirmar antes de se apoiar neles em um trabalho formal. Relate as correções por meio da skill de manutenção.", "",
     "## Livros, artigos, normas e guias", ""]
for i, r in enumerate(sorted(refs, key=key), 1):
    o.append(f"{i}. {r} (citado em {cite(refs[r])})")
o += ["", "## Artigos da Wikipedia", ""]
for i, (u, (title, ns)) in enumerate(sorted(wiki.items(), key=lambda kv: kv[1][0].lower()), 1):
    o.append(f"{i}. Wikipedia, [{title}]({u}) (citado em {cite(ns)})")
open(f"{VI}/{adir('references-and-further-reading')}/index.md", "w").write("\n".join(o) + "\n")
print("12.6 refs:", len(refs), len(wiki), file=sys.stderr)

# 12.7 index
metrics = {}; wurl = {}
url_title = {u: v[0] for u, v in wiki.items()}
for num, t in texts.items():
    if num.endswith(".0"): continue
    for c in table(sec(t, "Definições de métricas")):
        metrics.setdefault(c[0], []).append(num)
    body = t.split("## Referências e leituras complementares")[0]
    for m in re.finditer(r"\]\((https://en\.wikipedia\.org/wiki/[^)\s]+(?:\([^)]*\))?[^)\s]*)\)", body):
        wurl.setdefault(m.group(1), set()).add(num)
FW = ["ITIL 5", "ITIL 4", "ITIL", "DORA", "SPACE", "DevEx", "OKR", "GQM", "Balanced scorecard", "Goal-Question-Metric", "Site reliability", "Lean", "Kanban Guide", "COBIT", "ISO/IEC 20000", "ISO/IEC 27001", "NIST", "Cynefin", "Value stream mapping", "HEART", "Four Keys", "Westrum", "CMMI", "FinOps", "COPC", "Team Topologies", "Theory of constraints"]
fw = {}
for f in FW:
    ns = [n for n, t in en.items() if re.search(rf"\b{re.escape(f)}\b", t.split("## References and further reading")[0])]
    if ns: fw[f] = ns
def fmt(ns): return ", ".join(sorted(set(ns), key=nk))
o = ["# Índice", "",
     "Conceitos, arcabouços e métricas, cada um com remissões aos tópicos em que aparecem. Os números são números de tópico. Os títulos estão no índice de conteúdos do README e na [estrutura](../../../../spec/structure.md). Para definições breves com seus tópicos de origem, veja o tópico 12.1, Glossário.", "",
     "## Arcabouços e modelos", ""]
for f in sorted(fw, key=str.lower):
    o.append(f"- **{f}**: {fmt(fw[f]) if len(fw[f]) <= 12 else fmt(sorted(fw[f], key=nk)[:12]) + ' e outros tópicos'}")
o += ["", "## Métricas", "", "Os nomes das métricas como aparecem na tabela de definições de cada tópico. As entradas completas estão no apêndice 12.2 (veja o tópico 12.2, Referência de definições e fórmulas de métricas).", ""]
for k in sorted(metrics): o.append(f"- **{k}**: {fmt(metrics[k])}")
o += ["", "## Conceitos", "", "Os conceitos vêm dos termos para os quais cada tópico faz link com a Wikipedia como contexto. O primeiro número costuma ser o tópico que explica o conceito de forma mais completa.", ""]
for u in sorted(wurl, key=lambda u: url_title.get(u, u).lower()):
    o.append(f"- **{url_title.get(u, u.rsplit('/', 1)[-1].replace('_', ' '))}**: {fmt(wurl[u])}")
open(f"{VI}/{adir('index')}/index.md", "w").write("\n".join(o) + "\n")
print("12.7:", len(fw), len(metrics), len(wurl), file=sys.stderr)
