#!/usr/bin/env python3
# Regenerates the ru-001 appendices 12.2 (metric definitions), 12.6 (references) and 12.7 (index)
# from the ru-001 content topics. The home topic is the authority; rerun after any ru-001 topic changes.
import os, re, sys
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
rows = [l.rstrip("\n").split("\t") for l in open(f"{root}/spec/topics.tsv")][1:]
VI = f"{root}/locales/ru-001/темы"
def nk(n): return [int(x) for x in n.split(".")]
def sec(t, n):
    m = re.search(rf"^## {re.escape(n)}\n(.*?)(?=^## |\Z)", t, re.M | re.S)
    return m.group(1) if m else ""
def table(s):
    out = []
    for l in s.splitlines():
        if l.startswith("|") and not l.startswith("| ---") and not l.startswith("| Метрика |"):
            out.append([x.strip() for x in l.strip().strip("|").split(" | ")])
    return out
def pid(path):
    return open(path).read().strip()
peer = {}
for d in os.listdir(VI):
    p = f"{VI}/{d}/.locale-peer-id"
    if os.path.exists(p): peer[pid(p)] = d
def adir(slug):
    return peer[pid(f"{root}/locales/en-001/topics/{slug}/.locale-peer-id")]
texts, titles, en = {}, {}, {}
PARTS = {}
for part, num, slug, ru in rows:
    if int(part) >= 12: continue
    d = adir(slug)
    texts[num] = open(f"{VI}/{d}/index.md").read()
    titles[num] = texts[num].splitlines()[0][2:]
    en[num] = open(f"{root}/locales/en-001/topics/{slug}/index.md").read()
    if num.endswith(".0"):
        PARTS[part] = re.sub(r"^Введение в часть \d+: ", "", titles[num])

# 12.2 metric definitions
o = []; total = 0; miss = []; cur = None
for part, num, slug, ru in rows:
    if int(part) >= 12 or num.endswith(".0"): continue
    t = texts[num]
    md = table(sec(t, "Определения метрик")); gv = {c[0]: c for c in table(sec(t, "Векторы манипуляции и ограждения")) if len(c) == 3}
    if part != cur:
        o.append(f"\n## Часть {part}: {PARTS[part]}\n"); cur = part
    o.append(f"### {num} {titles[num]}\n")
    o.append(f"Тема-источник: (см. тему {num}, {titles[num]}).\n")
    o.append("| Метрика | Определение | Формула | Единица | Источник данных | Практика ITIL | Agile-аналог | Периодичность | Вектор манипуляции | Ограждение |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
    for c in md:
        if len(c) != 8: miss.append((num, c[0], len(c))); continue
        g = gv.get(c[0])
        if not g: miss.append((num, c[0], "nogaming")); continue
        o.append("| " + " | ".join(c[:8] + [g[1], g[2]]) + " |"); total += 1
    o.append("")
HEAD = """# Справочник определений и формул метрик

Это приложение перечисляет каждую метрику, определённую в темах с содержанием, сгруппированную по части и теме. Каждая запись содержит определение, формулу, единицу, источник данных, связанную практику ITIL, Agile-аналог и периодичность из темы-источника вместе с соответствующими вектором манипуляции и ограждением. Оно порождается из двух разделов «Определения метрик» и «Векторы манипуляции и ограждения» каждой темы, так что тема-источник остаётся авторитетом. Если запись здесь отличается от её темы, верна тема, а приложение порождается заново.

## Как пользоваться справочником

- **Смотрите до принятия.** Прежде чем поместить метрику на панель, прочтите её запись, включая вектор манипуляции и ограждение, и применяйте ограждение вместе с ней (см. тему 1.3, Результаты важнее выпуска: что выбрать для измерения).
- **Измеряйте команды, услуги и системы.** Ни одна запись не предназначена для ранжирования отдельных людей (см. тему 1.2, Закон Гудхарта и психология метрик).
- **Для суждений предпочитайте тему-источник.** Формулы здесь кратки. Определения терминов, заметки о выборках и практические примеры находятся в теме-источнике.
- **Записывайте свои вариации.** Если ваша организация меняет определение, запишите изменение и причину в своём реестре метрик (см. тему 1.4, Управление метриками и ответственность за них). Поможет карточка метрики (см. тему 12.4, Шаблоны).
- **Иллюстративные цифры помечены.** В этом приложении нет эталонных значений. Все цифры берутся из ваших собственных базовых уровней.
"""
open(f"{VI}/{adir('metric-definitions-and-formulas-reference')}/index.md", "w").write(HEAD + "\n".join(o))
print("12.2 metrics:", total, "missing:", miss, file=sys.stderr)

# 12.6 references (entries are kept verbatim; the cited-in lists use topic numbers)
refs = {}; wiki = {}
for part, num, slug, ru in rows:
    if int(part) >= 12: continue
    m = re.search(r"^## Источники и дополнительное чтение\n(.*?)\Z", texts[num], re.M | re.S)
    if not m: continue
    for l in m.group(1).splitlines():
        mm = re.match(r"\d+\. (.*)", l)
        if not mm: continue
        r = mm.group(1).strip()
        if r.startswith("Wikipedia, "):
            wm = re.match(r"Wikipedia, \[(.*)\]\((.*)\)\.?$", r)
            wiki.setdefault(wm.group(2), [wm.group(1), []])[1].append(num)
        else:
            refs.setdefault(r, []).append(num)
def key(r): return re.sub(r"[^a-z0-9 ]", "", r.lower())
cite = lambda ns: ", ".join(sorted(set(ns), key=nk))
o = ["# Источники и дополнительное чтение", "",
     "Это приложение собирает источники, процитированные в темах с содержанием, вместе с темами, цитирующими каждый. Записи расположены по алфавиту автора или организации и сохранены в исходной форме, без изменений. Тема-источник остаётся местом, где видно, как используется источник.", "",
     "## О проверке", "",
     "Ссылки на Википедию в этой книге проверены на открытие. Книги, статьи, стандарты и руководства цитировались авторами по памяти, и не все были сверены с оригиналами. Относитесь к библиографическим данным (год, издание, название) как к подсказкам, которые нужно подтвердить, прежде чем опираться на них в формальной работе. Сообщайте об исправлениях через навык сопровождения.", "",
     "## Книги, статьи, стандарты и руководства", ""]
for i, r in enumerate(sorted(refs, key=key), 1):
    o.append(f"{i}. {r} (цитируется в {cite(refs[r])})")
o += ["", "## Статьи Википедии", ""]
for i, (u, (title, ns)) in enumerate(sorted(wiki.items(), key=lambda kv: kv[1][0].lower()), 1):
    o.append(f"{i}. Wikipedia, [{title}]({u}) (цитируется в {cite(ns)})")
open(f"{VI}/{adir('references-and-further-reading')}/index.md", "w").write("\n".join(o) + "\n")
print("12.6 refs:", len(refs), len(wiki), file=sys.stderr)

# 12.7 index
metrics = {}; wurl = {}
url_title = {u: v[0] for u, v in wiki.items()}
for num, t in texts.items():
    if num.endswith(".0"): continue
    for c in table(sec(t, "Определения метрик")):
        metrics.setdefault(c[0], []).append(num)
    body = t.split("## Источники и дополнительное чтение")[0]
    for m in re.finditer(r"\]\((https://en\.wikipedia\.org/wiki/[^)\s]+(?:\([^)]*\))?[^)\s]*)\)", body):
        wurl.setdefault(m.group(1), set()).add(num)
FW = ["ITIL 5", "ITIL 4", "ITIL", "DORA", "SPACE", "DevEx", "OKR", "GQM", "Balanced scorecard", "Goal-Question-Metric", "Site reliability", "Lean", "Kanban Guide", "COBIT", "ISO/IEC 20000", "ISO/IEC 27001", "NIST", "Cynefin", "Value stream mapping", "HEART", "Four Keys", "Westrum", "CMMI", "FinOps", "COPC", "Team Topologies", "Theory of constraints"]
fw = {}
for f in FW:
    ns = [n for n, t in en.items() if re.search(rf"\b{re.escape(f)}\b", t.split("## References and further reading")[0])]
    if ns: fw[f] = ns
def fmt(ns): return ", ".join(sorted(set(ns), key=nk))
o = ["# Указатель", "",
     "Понятия, рамки и метрики, каждое с отсылками к темам, где оно встречается. Числа суть номера тем. Названия находятся в оглавлении README и в [структуре](../../../../spec/structure.md). Краткие определения с их темами-источниками см. в теме 12.1, Глоссарий.", "",
     "## Рамки и модели", ""]
for f in sorted(fw, key=str.lower):
    o.append(f"- **{f}**: {fmt(fw[f]) if len(fw[f]) <= 12 else fmt(sorted(fw[f], key=nk)[:12]) + ' и другие темы'}")
o += ["", "## Метрики", "", "Названия метрик так, как они значатся в таблице определений каждой темы. Полные записи находятся в приложении 12.2 (см. тему 12.2, Справочник определений и формул метрик).", ""]
for k in sorted(metrics): o.append(f"- **{k}**: {fmt(metrics[k])}")
o += ["", "## Понятия", "", "Понятия берутся из терминов, на которые каждая тема ссылается в Википедии как на контекст. Первый номер обычно есть тема, объясняющая понятие полнее всего.", ""]
for u in sorted(wurl, key=lambda u: url_title.get(u, u).lower()):
    o.append(f"- **{url_title.get(u, u.rsplit('/', 1)[-1].replace('_', ' '))}**: {fmt(wurl[u])}")
open(f"{VI}/{adir('index')}/index.md", "w").write("\n".join(o) + "\n")
print("12.7:", len(fw), len(metrics), len(wurl), file=sys.stderr)
